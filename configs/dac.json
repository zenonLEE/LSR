{
  "name": "dac_multiscale_clean",
  "dataset": "dac",
  "data_path": "data/processed/dac_with_xgb.csv",
  "target_column": "CO2_uptake",
  "feature_columns": [
    "SBET_before",
    "SBET_after",
    "Vpore_before",
    "Vpore_after",
    "amine_code",
    "MW",
    "N_content",
    "primary_amine",
    "secondary_amine",
    "tertiary_amine",
    "loading",
    "temp_C",
    "CO2_ppm",
    "RH"
  ],
  "split_strategy": "locked_column",
  "split_column": "split",
  "train_value": "train",
  "test_value": "test",
  "test_size": 0.2,
  "split_seed": 42,
  "k_max": 15,
  "scales": [
    7,
    11,
    15
  ],
  "rules_path": "rules/dac_clean_v2.md",
  "prediction_column": "v3_multik_pred",
  "xgb_reference": "xgb_pred",
  "output_range": [
    0.04,
    6
  ],
  "thresholds": {
    "short_long_confident": 0.15,
    "short_long_boundary": 0.4,
    "short_std_ratio": 0.7,
    "long_std_threshold": 0.6
  }
}
